# ── БД (с фазы 4, значения совпадают с infra/docker-compose.yml) ──
DATABASE_URL=postgres://spyapp:spyapp@localhost:5432/spyapp

# ── API ──
API_PORT=4000
# Потоки самолётов и судов: 1 = фейковый мир (симулятор), 0 = реальные OpenSky + adsb.lol
SIMULATE=1
# 1 = вообще без внешних сервисов: спутники, поиск мест и фото берутся из встроенных данных
# OFFLINE=1
# Потолок запросов к adsb.lol при SIMULATE=0 (подстраивается под 429)
# ADSBLOL_RPS=0.5
# SIM_AIRCRAFT=10000
# SIM_VESSELS=5000
WEB_ORIGIN=http://localhost:5173

# ── Глобус (фронтенд, префикс VITE_ виден в браузере!) ──
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
VITE_CESIUM_ION_TOKEN=

# ── Источники данных (только сервер) ──
# OpenSky: без ключей работает анонимно (весь мир раз в 15 мин), с бесплатным API-клиентом раз в 90 с
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AISSTREAM_API_KEY=
NASA_FIRMS_MAP_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
TOMTOM_API_KEY=
WINDY_WEBCAMS_API_KEY=
GOOGLE_MAP_TILES_API_KEY=
